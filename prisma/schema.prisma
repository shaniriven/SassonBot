generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Bar {
  id         String   @id @default(uuid())
  name       String
  telegramId String   @unique
  createdAt  DateTime @default(now())
}

model User {
  id         String   @id @default(uuid())
  telegramId String   @unique
  isAdmin    Boolean  @default(false)
  createdAt  DateTime @default(now())
}

model Match {
  id          String   @id @default(uuid())
  apiId       Int      @unique
  homeTeam    String
  awayTeam    String
  homeLogo    String?
  awayLogo    String?
  league      String
  kickoffTime DateTime
  matchDate   String
  status      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  descriptions Description[]
}

model Post {
  id             String   @id @default(uuid())
  postDate       String
  telegramFileId String?
  createdAt      DateTime @default(now())
}

model Background {
  id           String   @id @default(uuid())
  filename     String   @unique
  lastUsedDate String?
}

model Font {
  id           String   @id @default(uuid())
  family       String   @unique
  lastUsedDate String?
}

model Description {
  id        String   @id @default(uuid())
  matchId   String
  match     Match    @relation(fields: [matchId], references: [id])
  caption   String
  createdAt DateTime @default(now())
}

model League {
  id          String   @id @default(uuid())
  apiId       Int      @unique
  seasonApiId Int?     @unique
  createdAt   DateTime @default(now())
}
